{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-step-progress-{{ ai_gen_id }} {
    background-color: {{ block.settings.container_background }};
    padding: {{ block.settings.container_padding }}px;
    border-radius: {{ block.settings.container_border_radius }}px;
    margin: {{ block.settings.container_margin }}px 0;
  }

  .ai-step-progress-container-{{ ai_gen_id }} {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 0;
    margin-left : 30px;
    margin-right : 20px;
    height: 100px !important;
    max-width: 100%;
  }

  .ai-step-item-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.step_background }};
    border: {{ block.settings.step_border_width }}px solid {{ block.settings.step_border_color }};
    padding: {{ block.settings.step_padding }}px;
    padding : 40px;
    text-align: center;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ai-step-item-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.active_step_background }};
  }

  .ai-step-item-{{ ai_gen_id }}:not(:last-child) {
    margin-right: -1px;
  }

  .ai-step-item-{{ ai_gen_id }}:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -{{ block.settings.arrow_size }}px;
    width: 0;
    height: 0;
    border-left: {{ block.settings.arrow_size }}px solid {{ block.settings.step_background }};
    border-top: {{ block.settings.arrow_size }}px solid transparent;
    border-bottom: {{ block.settings.arrow_size }}px solid transparent;
    z-index: 2;
    transform: translateY(-50%);
  }

  .ai-step-item-{{ ai_gen_id }}.active:not(:last-child)::after {
    border-left-color: {{ block.settings.active_step_background }};
  }

  .ai-step-item-{{ ai_gen_id }}:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 50%;
    right: -{{ block.settings.arrow_size | plus: 1 }}px;
    width: 0;
    height: 0;
    border-left: {{ block.settings.arrow_size | plus: 1 }}px solid {{ block.settings.step_border_color }};
    border-top: {{ block.settings.arrow_size | plus: 1 }}px solid transparent;
    border-bottom: {{ block.settings.arrow_size | plus: 1 }}px solid transparent;
    z-index: 1;
    transform: translateY(-50%);
  }

  .ai-step-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }
 
  .ai-step-icon-{{ ai_gen_id }} {
  width: 24px;
  height: 40px;
  background: url('https://css.brilliantearth.com/static/img/svg/setting.svg') no-repeat center;
  background-size: contain;
}


 .ai-step1-icon-{{ ai_gen_id }} {
  width: 60px;
  height: 60px;
  background: url('https://static.vecteezy.com/system/resources/previews/048/723/218/non_2x/beautiful-diamond-isolated-on-transparent-background-free-png.png') no-repeat center;
  background-size: contain;
}

 .ai-step2-icon-{{ ai_gen_id }} {
  width: 60px;
  height: 60px;
  background: url('https://css.brilliantearth.com/static/img/svg/ring.svg') no-repeat center;
  background-size: contain;
}

  .ai-step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.2;flex-grow: 1;
  }

  .ai-step-details-{{ ai_gen_id }} {
    font-size: {{ block.settings.details_font_size }}px;
    color: {{ block.settings.details_color }};
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .ai-step-links-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
  }

  .ai-step-link-{{ ai_gen_id }} {
    font-size: {{ block.settings.link_font_size }}px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
  }

  .ai-step-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
    text-decoration: underline;
  }

  @media screen and (max-width: 768px) {
    .ai-step-progress-{{ ai_gen_id }} {
      padding: {{ block.settings.container_padding | times: 0.7 }}px;
    }

    .ai-step-item-{{ ai_gen_id }} {
      padding: {{ block.settings.step_padding | times: 0.6 }}px;
    }

    .ai-step-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.8 }}px;
    }

    .ai-step-details-{{ ai_gen_id }} {
      font-size: {{ block.settings.details_font_size | times: 0.8 }}px;
      margin-bottom: 4px;
    }

    .ai-step-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.link_font_size | times: 0.8 }}px;
    }

    .ai-step-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.7 }}px;
      height: {{ block.settings.icon_size | times: 0.7 }}px;
    }

    .ai-step-links-{{ ai_gen_id }} {
      gap: 8px;
    }

    .ai-step-header-{{ ai_gen_id }} {
      margin-bottom: 4px;
    }

    .ai-step-item-{{ ai_gen_id }}:not(:last-child)::after {
      right: -{{ block.settings.arrow_size | times: 0.8 }}px;
      border-left-width: {{ block.settings.arrow_size | times: 0.8 }}px;
      border-top-width: {{ block.settings.arrow_size | times: 0.8 }}px;
      border-bottom-width: {{ block.settings.arrow_size | times: 0.8 }}px;
    }

    .ai-step-item-{{ ai_gen_id }}:not(:last-child)::before {
      right: -{{ block.settings.arrow_size | times: 0.8 | plus: 1 }}px;
      border-left-width: {{ block.settings.arrow_size | times: 0.8 | plus: 1 }}px;
      border-top-width: {{ block.settings.arrow_size | times: 0.8 | plus: 1 }}px;
      border-bottom-width: {{ block.settings.arrow_size | times: 0.8 | plus: 1 }}px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-step-progress-{{ ai_gen_id }} {
      width : 410px;
      margin-left : -40px;
      padding: {{ block.settings.container_padding | times: 0.5 }}px;
    }

    .ai-step-item-{{ ai_gen_id }} {
      padding: {{ block.settings.step_padding | times: 0.4 }}px;
    }

    .ai-step-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.7 }}px;
    }

    .ai-step-details-{{ ai_gen_id }} {
      font-size: {{ block.settings.details_font_size | times: 0.7 }}px;
      margin-bottom: 2px;
      
    }

    .ai-step-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.link_font_size | times: 0.7 }}px;
    }

    .ai-step-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.4 }}px;
      height: {{ block.settings.icon_size | times: 0.4 }}px;
    }

    .ai-step-links-{{ ai_gen_id }} {
      gap: 6px;
    }

    .ai-step-header-{{ ai_gen_id }} {
      margin-bottom: 2px;
    }

    .ai-step-item-{{ ai_gen_id }}:not(:last-child)::after {
      right: -{{ block.settings.arrow_size | times: 0.6 }}px;
      border-left-width: {{ block.settings.arrow_size | times: 0.6 }}px;
      border-top-width: {{ block.settings.arrow_size | times: 0.6 }}px;
      border-bottom-width: {{ block.settings.arrow_size | times: 0.6 }}px;
    }

    .ai-step-item-{{ ai_gen_id }}:not(:last-child)::before {
      right: -{{ block.settings.arrow_size | times: 0.6 | plus: 1 }}px;
      border-left-width: {{ block.settings.arrow_size | times: 0.6 | plus: 1 }}px;
      border-top-width: {{ block.settings.arrow_size | times: 0.6 | plus: 1 }}px;
      border-bottom-width: {{ block.settings.arrow_size | times: 0.6 | plus: 1 }}px;
    }

    @media screen and (max-width: 480px) {
  .ai-step-progress-container-{{ ai_gen_id }} .ai-step-item-{{ ai_gen_id }}:first-child {
    display: none;
  }
}


  }
{% endstyle %}

<div class="ai-step-progress-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div style="height : -300px;" class="ai-step-progress-container-{{ ai_gen_id }}">
    <div class="ai-step-item-{{ ai_gen_id }} {% if block.settings.step1_active %}active{% endif %}">
      <div class="ai-step-header-{{ ai_gen_id }}">
        <h3 class=" ai-step-title-{{ ai_gen_id }}">{{ block.settings.step1_title }}</h3></div>
    </div>

    <div class="ai-step-item-{{ ai_gen_id }} {% if block.settings.step2_active %}active{% endif %}">
      <div class="ai-step-header-{{ ai_gen_id }}">
        <h3 style="padding : -58px !important;" class="ai-step-title-{{ ai_gen_id }}">{{ block.settings.step2_title }}</h3>
        <div style="width : 40px; padding : -10px !important;" class="ai-step1-icon-{{ ai_gen_id }}">
          {% comment %} <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L15.09 8.26L22 9L1714L18.18 21L12 17.77L5.82 21L7 14L2 9L8.91 8.26L12 2Z"/>
          </svg> {% endcomment %}
        </div>
      </div>{% if block.settings.step2_details != blank %}
        <p style="margin-top : -20px !important;" class="ai-step-details-{{ ai_gen_id }}">{{ block.settings.step2_details }}</p>
      {% endif %}
      <div style="display : flex; justify-content : center;" class="ai-step-links-{{ ai_gen_id }}">
        {% if block.settings.step2_view_link != blank %}
          <a href="{{ block.settings.step2_view_link }}" class="ai-step-link-{{ ai_gen_id }}">{{ block.settings.step2_view_text }}</a>
        {% endif %}
        {% if block.settings.step2_change_link != blank %}
          <a href="{{ block.settings.step2_change_link }}" class="ai-step-link-{{ ai_gen_id }}">{{ block.settings.step2_change_text }}</a>
        {% endif %}
      </div>
    </div>

    <div class="ai-step-item-{{ ai_gen_id }} {% if block.settings.step3_active %}active{% endif %}">
      <div class="ai-step-header-{{ ai_gen_id }}">
        <h3 class="ai-step-title-{{ ai_gen_id }}">{{ block.settings.step3_title }}</h3>
        <div style="width : 80px; height : 80px;" class="ai-step-icon-{{ ai_gen_id }}">
          {% comment %} <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C13.1 2 14 2.9 14 4C14 5.1 13.1 6 12 6C10.9 6 10 5.1 10 4C10 2.9 10.9 2 12 2M21 9V7L15 1L9 7V9C9 108 11 7 11V13H17V11C16 11 15 10 15 9H21Z"/>
          </svg> {% endcomment %}
        </div>
      </div>
    </div>

    <div class="ai-step-item-{{ ai_gen_id }} {% if block.settings.step4_active %}active{% endif %}">
      <div class="ai-step-header-{{ ai_gen_id }}">
        <h3 class="ai-step-title-{{ ai_gen_id }}">{{ block.settings.step4_title }}</h3>
        <div style="width : 80px; height : 80px;"class="ai-step2-icon-{{ ai_gen_id }}">
          {% comment %} <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C13.1 2 14 2.9 14 4C14 5.1 13.1 6 12 6C10.9 6 10 5.1 10 4C10 2.9 10.9 2 12 2M21 9V7L15 1L9 7V9C9 10 8 11 7 11V13H17V11C16 11 15 10 15 9H21M7 18C7 16.9 7.9 16 9 16S11 16.9 11 18 10.1 209 20 7 19.1 7 18M13 18C13 16.9 13.9 16 15 16S17 16.9 17 18 16.1 20 15 20 13 19.1 13 18Z"/>
          </svg> {% endcomment %}
        </div>
      </div>
      <div style="display : flex; justify-content : center; margin-top : -26px;" class="ai-step-links-{{ ai_gen_id }}">
        {% if block.settings.step4_size_link != blank %}
          <a href="{{ block.settings.step4_size_link }}" class="ai-step-link-{{ ai_gen_id }}">{{ block.settings.step4_size_text }}</a>
        {% endif %}</div>
    </div>
  </div>
</div>

{% schema %}
