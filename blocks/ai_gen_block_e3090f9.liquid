
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-list-{{ ai_gen_id }} {
    margin: 0 12px;
  }

  .ai-collection-list__header-{{ ai_gen_id }} {
    text-align: left;
    margin-top: 100px;
    margin-left: 22px;
    margin-bottom: 32px;
  }

  .ai-collection-list__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px;
  }

  .ai-collection-list__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-collection-list__grid-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    width: 100%;
  }

  .ai-collection-list__item-{{ ai_gen_id }} {
    flex: 1;
    text-align: center;
    min-width: 0;
  }

  .ai-collection-list__link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-collection-list__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 250px;
    margin-bottom: 12px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    position: relative;
  }

  .ai-collection-list__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease, opacity 0.3s ease;}

  .ai-collection-list__image--primary-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 1;
  }

  .ai-collection-list__image--secondary-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }

  .ai-collection-list__link-{{ ai_gen_id }}:hover .ai-collection-list__image--primary-{{ ai_gen_id }} {
    opacity: 0;
    transform: scale(1.05);
  }

  .ai-collection-list__link-{{ ai_gen_id }}:hover .ai-collection-list__image--secondary-{{ ai_gen_id }} {
    opacity: 1;
    transform: scale(1.05);
  }

  .ai-collection-list__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .ai-collection-list__link-{{ ai_gen_id }}:hover .ai-collection-list__image-placeholder-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-collection-list__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;opacity: 0.3;
  }

  .ai-collection-list__collection-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.collection_title_size }}px;
    color: {{ block.settings.collection_title_color }};
    margin: 0;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .ai-collection-list__link-{{ ai_gen_id }}:hover .ai-collection-list__collection-title-{{ ai_gen_id }} {
    color: {{ block.settings.collection_title_hover_color }};
  }

  .ai-collection-list__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #666;
    text-align: center;pointer-events: none;
  }

  @media screen and (max-width: 990px) {
    .ai-collection-list__grid-{{ ai_gen_id }} {
      flex-wrap: wrap;
    }

    .ai-collection-list__item-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - 2px);
    }

    .ai-collection-list__image-wrapper-{{ ai_gen_id }} {
      height: 200px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-collection-list__item-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - 2px);
    }

    .ai-collection-list__image-wrapper-{{ ai_gen_id }} {
      height: 160px;
    }
  }
{% endstyle %}<div class="ai-collection-list-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank or block.settings.subtitle != blank %}
    <div class="ai-collection-list__header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-collection-list__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-collection-list__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-collection-list__grid-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign hover_image_key = 'hover_image_' | append: i
        assign collection = block.settings[collection_key]
        assign hover_image = block.settings[hover_image_key]
      %}
      <div class="ai-collection-list__item-{{ ai_gen_id }}">
        {% if collection != blank %}
          <a href="{{ collection.url }}" class="ai-collection-list__link-{{ ai_gen_id }}">
            <div class="ai-collection-list__image-wrapper-{{ ai_gen_id }}">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 600 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  class="ai-collection-list__image-{{ ai_gen_id }} ai-collection-list__image--primary-{{ ai_gen_id }}"loading="lazy"
                  width="600"
                  height="600"
                >{% if hover_image %}
                  <img
                    src="{{ hover_image | image_url: width: 600 }}"
                    alt="{{ hover_image.alt | escape }}"
                    class="ai-collection-list__image-{{ ai_gen_id }} ai-collection-list__image--secondary-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% endif %}
              {% else %}
                <div class="ai-collection-list__image-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}</div>
              {% endif %}
            </div>
            <h3 class="ai-collection-list__collection-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
          </a>
        {% else %}
          <div class="ai-collection-list__image-wrapper-{{ ai_gen_id }}">
            <div class="ai-collection-list__image-placeholder-{{ ai_gen_id }}">
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
              <div class="ai-collection-list__empty-state-{{ ai_gen_id }}">
                Add collection {{ i }}
              </div>
            </div>
          </div>
          <h3 class="ai-collection-list__collection-title-{{ ai_gen_id }}">Collection {{ i }}</h3>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

