{% doc %}
  @prompt
     features section with a heading at the top.
    Below the heading, display 5 feature blocks in one row (desktop) and stacked 2 per row on mobile.
    Each feature block should include:
    
    An icon image or SVG upload option inside a circle.
    
    A title text below the icon should clikeable and linked (customizable).
    
    Optional description text below the title.
    Background color should be customizable.
    Heading should be centered at the top.
    Add spacing between icons and text, and allow custom text color, no discription icon should be littlebit big, i mages should be litle big, no need a images background just image 250 width and height

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: 60px 20px;
  }

  .ai-features-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-features-heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 50px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-features-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 30px;
  }

  .ai-feature-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-feature-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    overflow: hidden;
  }

  .ai-feature-icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-feature-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-feature-icon-placeholder-{{ ai_gen_id }} svg {
    width: 80%;
    height: 80%;
    color: #999;
  }

  .ai-feature-title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 {{ block.settings.text_spacing }}px;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .ai-feature-title-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-feature-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.5;
    margin: 0;
    opacity: 0.8;
  }

  @media screen and (max-width: 768px) {
    .ai-features-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);gap: 25px;
    }

    .ai-features-section-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-features-heading-{{ ai_gen_id }} {
      margin-bottom: 30px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-feature-icon-wrapper-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size }}px * 0.8);
      height: calc({{ block.settings.icon_size }}px * 0.8);
    }
  }
{% endstyle %}<div class="ai-features-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-features-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-features-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}<div class="ai-features-grid-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign icon_key = 'feature_' | append: i | append: '_icon'
          assign title_key = 'feature_' | append: i | append: '_title'
          assign link_key = 'feature_' | append: i | append: '_link'
          assign description_key = 'feature_' | append: i | append: '_description'

          assign feature_icon = block.settings[icon_key]
          assign feature_title = block.settings[title_key]
          assign feature_link = block.settings[link_key]
          assign feature_description = block.settings[description_key]
        %}

        <div style="border-right : 1px solid rgb(197, 190, 190)" class="ai-feature-item-{{ ai_gen_id }}">
          <div class="ai-feature-icon-wrapper-{{ ai_gen_id }}">
            {% if feature_icon %}
              <img
                src="{{ feature_icon | image_url: width: 250 }}"
                alt="{{ feature_icon.alt | escape }}"
                class="ai-feature-icon-{{ ai_gen_id }}"
                loading="lazy"
                width="250"
                height="250"
              >
            {% else %}
              <div class="ai-feature-icon-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if feature_title != blank %}
            {% if feature_link != blank %}
              <a href="{{ feature_link }}" class="ai-feature-title-{{ ai_gen_id }}">
                {{ feature_title }}
              </a>
            {% else %}
              <h3 class="ai-feature-title-{{ ai_gen_id }}">{{ feature_title }}</h3>
            {% endif %}
          {% endif %}

          {% if feature_description != blank %}
            <p class="ai-feature-description-{{ ai_gen_id }}">{{ feature_description }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

