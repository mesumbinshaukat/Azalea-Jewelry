        this.currentStep = 1;
        this.formData = {
          shape: 'Round',
          carat: '3.00',
          diamond_price: 3475
        };
      }

      connectedCallback() {
        console.log('[INIT] ========== CUSTOM ENGAGEMENT FORM INITIALIZED ==========');
        console.log('[INIT] Form ID: {{ ai_gen_id }}');
        
        this.loadFromLocalStorage();
        console.log('[INIT] Loaded data from localStorage:', this.formData);
        
        this.setupFileInputs();
        console.log('[INIT] File inputs setup complete');
        
        this.setupMetalSelection();
        console.log('[INIT] Metal selection setup complete');
        
        this.setupStepNavigation();
        console.log('[INIT] Step navigation setup complete');
        
        this.setupDiamondSelectors();
        console.log('[INIT] Diamond selectors setup complete');
        
        this.setupReviewEditing();
        console.log('[INIT] Review editing setup complete');
        
        this.setupCharacterCounter();
        console.log('[INIT] Character counter setup complete');
        
        this.populateFormFromData();
        console.log('[INIT] Form populated from saved data');
        
        console.log('[INIT] ========== INITIALIZATION COMPLETE ==========');
      }

      // Character Counter for Textarea
      setupCharacterCounter() {
        const textarea = this.querySelector('#description-{{ ai_gen_id }}');
        const counterEl = textarea ? textarea.parentElement.querySelector('.ai-custom-form-note-{{ ai_gen_id }}') : null;
        
        if (textarea && counterEl) {
          const updateCounter = () => {
            const count = textarea.value.length;
            counterEl.textContent = `${count} CHARACTERS`;
          };
          
          textarea.addEventListener('input', updateCounter);
          updateCounter(); // Initial count
        }
      }

      // LocalStorage Management
      saveToLocalStorage() {
        try {
          localStorage.setItem('customEngagementForm_{{ ai_gen_id }}', JSON.stringify(this.formData));
        } catch (e) {
          console.error('Failed to save to localStorage', e);
        }
      }

      loadFromLocalStorage() {
        try {
          const saved = localStorage.getItem('customEngagementForm_{{ ai_gen_id }}');
          if (saved) {
            this.formData = { ...this.formData, ...JSON.parse(saved) };
          }
        } catch (e) {
          console.error('Failed to load from localStorage', e);
        }
      }

      clearLocalStorage() {
        try {
          localStorage.removeItem('customEngagementForm_{{ ai_gen_id }}');
        } catch (e) {
          console.error('Failed to clear localStorage', e);
        }
      }

      // Step Navigation
      showStep(stepNumber) {
        console.log(`[STEP NAVIGATION] Moving to Step ${stepNumber}`);
        console.log('[STEP NAVIGATION] Current form data:', this.formData);
        
        const steps = this.querySelectorAll('[data-step]');
        steps.forEach(step => {
          step.classList.remove('active');
          if (parseInt(step.getAttribute('data-step')) === stepNumber) {
            step.classList.add('active');
          }
        });
        this.currentStep = stepNumber;
        window.scrollTo({ top: 0, behavior: 'smooth' });
        
        console.log(`[STEP NAVIGATION] Successfully moved to Step ${stepNumber}`);
      }

      setupStepNavigation() {
        // Step 1 Continue
        const continueStep1 = this.querySelector('[data-continue-step1]');
        if (continueStep1) {
          continueStep1.addEventListener('click', () => {
            if (this.validateStep1()) {
              this.collectFormData();
              this.saveToLocalStorage();
              this.showStep(2);
            }
          });
        }

        // Step 2 Navigation
        const backStep2 = this.querySelector('[data-back-step2]');
        const continueStep2 = this.querySelector('[data-continue-step2]');
        
        if (backStep2) {
          backStep2.addEventListener('click', () => {
            this.collectFormData();
            this.saveToLocalStorage();
            this.showStep(1);
          });
        }

        if (continueStep2) {
          continueStep2.addEventListener('click', () => {
            this.collectFormData();
            this.saveToLocalStorage();
            this.populateReview();
            this.showStep(3);
          });
        }

        // Step 3 Navigation
        const backStep3 = this.querySelector('[data-back-step3]');
        const submitForm = this.querySelector('[data-submit-form]');
        
        if (backStep3) {
          backStep3.addEventListener('click', () => {
            this.collectFormData();
            this.saveToLocalStorage();
            this.showStep(2);
          });
        }

        if (submitForm) {
          submitForm.addEventListener('click', () => {
            if (this.validateStep3()) {
              this.collectFormData();
              this.submitFormData();
            }
          });
        }
      }

      // Form Data Collection
      collectFormData() {
        console.log('[DATA COLLECTION] Starting data collection...');
        
        const fields = this.querySelectorAll('[data-field]');
        fields.forEach(field => {
          const fieldName = field.getAttribute('data-field');
          if (field.type === 'radio') {
            if (field.checked) {
              this.formData[fieldName] = field.value;
              console.log(`[DATA COLLECTION] Radio field "${fieldName}": ${field.value}`);
            }
          } else if (field.type === 'checkbox') {
            this.formData[fieldName] = field.checked;
            console.log(`[DATA COLLECTION] Checkbox field "${fieldName}": ${field.checked}`);
          } else {
            this.formData[fieldName] = field.value;
            console.log(`[DATA COLLECTION] Field "${fieldName}": ${field.value}`);
          }
        });

        // Collect file names
        const fileInput1 = this.querySelector('[data-file-input="1"]');
        const fileInput2 = this.querySelector('[data-file-input="2"]');
        if (fileInput1 && fileInput1.files[0]) {
          this.formData.file1_name = fileInput1.files[0].name;
          console.log(`[DATA COLLECTION] File 1: ${fileInput1.files[0].name}`);
        }
        if (fileInput2 && fileInput2.files[0]) {
          this.formData.file2_name = fileInput2.files[0].name;
          console.log(`[DATA COLLECTION] File 2: ${fileInput2.files[0].name}`);
        }
        
        console.log('[DATA COLLECTION] Complete form data:', this.formData);
      }

      populateFormFromData() {
        Object.keys(this.formData).forEach(key => {
          const field = this.querySelector(`[data-field="${key}"]`);
          if (field) {
            if (field.type === 'radio') {
              if (field.value === this.formData[key]) {
                field.checked = true;
                field.dispatchEvent(new Event('change'));
              }
            } else if (field.type === 'checkbox') {
              field.checked = this.formData[key];
            } else {
              field.value = this.formData[key];
            }
          }
        });

        // Update character counter if description exists
        const textarea = this.querySelector('#description-{{ ai_gen_id }}');
        if (textarea && textarea.value) {
          textarea.dispatchEvent(new Event('input'));
        }
      }

      // Validation
      validateStep1() {
        console.log('[VALIDATION] Validating Step 1...');
        
        const description = this.querySelector('#description-{{ ai_gen_id }}');
        const ringSize = this.querySelector('#ring-size-{{ ai_gen_id }}');
        const metalColor = this.querySelector('input[name="metal_color_{{ ai_gen_id }}"]:checked');

        console.log('[VALIDATION] Description length:', description?.value?.trim()?.length || 0);
        console.log('[VALIDATION] Metal color selected:', metalColor?.value || 'None');
        console.log('[VALIDATION] Ring size selected:', ringSize?.value || 'None');

        if (!description || description.value.trim().length < 15) {
          console.log('[VALIDATION] ❌ FAILED: Description too short');
          alert('Please provide a description of at least 15 characters.');
          description && description.focus();
          return false;
        }

        if (!metalColor) {
          console.log('[VALIDATION] ❌ FAILED: No metal color selected');
          alert('Please select a metal color.');
          return false;
        }

        if (!ringSize || !ringSize.value) {
          console.log('[VALIDATION] ❌ FAILED: No ring size selected');
          alert('Please select a ring size.');
          ringSize && ringSize.focus();
          return false;
        }

        console.log('[VALIDATION] ✅ Step 1 validation passed');
        return true;
      }

      validateStep3() {
        console.log('[VALIDATION] Validating Step 3...');
        
        const email = this.querySelector('#email-{{ ai_gen_id }}');
        const terms = this.querySelector('#terms-{{ ai_gen_id }}');

        console.log('[VALIDATION] Email:', email?.value || 'None');
        console.log('[VALIDATION] Email valid:', email?.validity?.valid || false);
        console.log('[VALIDATION] Terms accepted:', terms?.checked || false);

        if (!email || !email.value || !email.validity.valid) {
          console.log('[VALIDATION] ❌ FAILED: Invalid email');
          alert('Please enter a valid email address.');
          email && email.focus();
          return false;
        }

        if (!terms || !terms.checked) {
          console.log('[VALIDATION] ❌ FAILED: Terms not accepted');
          alert('Please accept the terms and conditions.');
          return false;
        }

        console.log('[VALIDATION] ✅ Step 3 validation passed');
        return true;
      }

      // File Upload Handling
      setupFileInputs() {
        const fileInputs = this.querySelectorAll('[data-file-input]');
        const fileTriggers = this.querySelectorAll('[data-file-trigger]');

        fileTriggers.forEach((trigger) => {
          trigger.addEventListener('click', (e) => {
            e.preventDefault();
            const index = trigger.getAttribute('data-file-trigger');
            const input = this.querySelector(`[data-file-input="${index}"]`);
            input && input.click();
          });
        });

        fileInputs.forEach((input) => {
          input.addEventListener('change', (e) => {
            const index = input.getAttribute('data-file-input');
            const preview = this.querySelector(`[data-file-preview="${index}"]`);
            const file = e.target.files[0];

            if (file) {
              if (file.size > 5 * 1024 * 1024) {
                alert('File size must be less than 5MB');
                input.value = '';
                preview && (preview.innerHTML = '');
                return;
              }

              const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
              if (!validTypes.includes(file.type)) {
                alert('Only JPG, PNG, and WEBP files are allowed');
                input.value = '';
                preview && (preview.innerHTML = '');
                return;
              }

              if (preview) {
                const reader = new FileReader();
                reader.onload = (e) => {
                  preview.innerHTML = `<div style="margin-top: 10px;">View ${index}: ${file.name}<br><img src="${e.target.result}" style="max-width: 100px; max-height: 100px; margin-top: 5px; border: 1px solid #CCC; border-radius: 4px;"></div>`;
                };
                reader.readAsDataURL(file);
              }
            } else {
              preview && (preview.innerHTML = '');
            }
          });
        });
      }

      // Metal Selection
      setupMetalSelection() {
        const metalRadios = this.querySelectorAll('[data-metal-radio]');
        const metalCircles = this.querySelectorAll('[data-metal-circle]');
        const metalSelectedDisplay = this.querySelector('#metal-selected-{{ ai_gen_id }}');

        metalRadios.forEach((radio, index) => {
          radio.addEventListener('change', () => {
            metalCircles.forEach((circle) => {
              circle.classList.remove('selected');
            });

            if (radio.checked && metalCircles[index]) {
              metalCircles[index].classList.add('selected');
              if (metalSelectedDisplay) {
                metalSelectedDisplay.textContent = `Selected: ${radio.value}`;
              }
            }
          });

          if (metalCircles[index]) {
            metalCircles[index].addEventListener('click', () => {
              radio.checked = true;
              radio.dispatchEvent(new Event('change'));
            });
          }
        });
      }

      // Diamond Selectors
      setupDiamondSelectors() {
        // Shape Selector
        const shapeItems = this.querySelectorAll('[data-shape]');
        shapeItems.forEach(item => {
          item.addEventListener('click', () => {
            shapeItems.forEach(s => s.classList.remove('selected'));
            item.classList.add('selected');
            this.formData.shape = item.getAttribute('data-shape');
            this.updateDiamondDisplay();
          });
        });

        // Carat Selector
        const caratValues = this.querySelectorAll('[data-carat]');
        caratValues.forEach(item => {
          item.addEventListener('click', () => {
            caratValues.forEach(c => c.classList.remove('selected'));
            item.classList.add('selected');
            this.formData.carat = item.getAttribute('data-carat');
            this.updateDiamondDisplay();
          });
        });

        // Diamond Option Radio
        const diamondOptions = this.querySelectorAll('input[name="diamond_option_{{ ai_gen_id }}"]');
        diamondOptions.forEach(option => {
          option.addEventListener('change', () => {
            const optionDivs = this.querySelectorAll('.ai-custom-form-diamond-option-{{ ai_gen_id }}');
            optionDivs.forEach(div => div.classList.remove('selected'));
            option.closest('.ai-custom-form-diamond-option-{{ ai_gen_id }}').classList.add('selected');
          });
        });
      }

      updateDiamondDisplay() {
        const price = Math.round(parseFloat(this.formData.carat) * 1158);
        this.formData.diamond_price = price;
        
        const priceEl = this.querySelector('#diamond-price-{{ ai_gen_id }}');
        const infoEl = this.querySelector('#diamond-info-{{ ai_gen_id }}');
        
        if (priceEl) {
          priceEl.textContent = `$${price.toLocaleString()}`;
        }
        
        if (infoEl) {
          infoEl.innerHTML = `<strong>${this.formData.shape} - ${this.formData.carat} ct</strong><br>Price - <span id="diamond-price-{{ ai_gen_id }}">$${price.toLocaleString()}</span>`;
        }
      }

      // Review Population
      populateReview() {
        const reviewStep1 = this.querySelector('#review-step1-{{ ai_gen_id }}');
        const reviewStep2 = this.querySelector('#review-step2-{{ ai_gen_id }}');

        if (reviewStep1) {
          let html = '';
          if (this.formData.file1_name) html += `<div class="ai-custom-form-review-item-{{ ai_gen_id }}"><span class="ai-custom-form-review-label-{{ ai_gen_id }}">Image 1</span><span class="ai-custom-form-review-value-{{ ai_gen_id }}">${this.formData.file1_name}</span></div>`;
          if (this.formData.file2_name) html += `<div class="ai-custom-form-review-item-{{ ai_gen_id }}"><span class="ai-custom-form-review-label-{{ ai_gen_id }}">Image 2</span><span class="ai-custom-form-review-value-{{ ai_gen_id }}">${this.formData.file2_name}</span></div>`;
          if (this.formData.image_url) html += `<div class="ai-custom-form-review-item-{{ ai_gen_id }}"><span class="ai-custom-form-review-label-{{ ai_gen_id }}">Image URL</span><span class="ai-custom-form-review-value-{{ ai_gen_id }}">${this.formData.image_url}</span></div>`;
          if (this.formData.description) html += `<div class="ai-custom-form-review-item-{{ ai_gen_id }}"><span class="ai-custom-form-review-label-{{ ai_gen_id }}">Description</span><span class="ai-custom-form-review-value-{{ ai_gen_id }}">${this.formData.description.substring(0, 100)}...</span></div>`;
          if (this.formData.metal_color) html += `<div class="ai-custom-form-review-item-{{ ai_gen_id }}"><span class="ai-custom-form-review-label-{{ ai_gen_id }}">Metal Color</span><span class="ai-custom-form-review-value-{{ ai_gen_id }}">${this.formData.metal_color}</span></div>`;
          if (this.formData.ring_size) html += `<div class="ai-custom-form-review-item-{{ ai_gen_id }}"><span class="ai-custom-form-review-label-{{ ai_gen_id }}">Ring Size</span><span class="ai-custom-form-review-value-{{ ai_gen_id }}">${this.formData.ring_size}</span></div>`;
          reviewStep1.innerHTML = html;
        }

        if (reviewStep2) {
          let html = '';
          if (this.formData.diamond_option) html += `<div class="ai-custom-form-review-item-{{ ai_gen_id }}"><span class="ai-custom-form-review-label-{{ ai_gen_id }}">Diamond Option</span><span class="ai-custom-form-review-value-{{ ai_gen_id }}">${this.formData.diamond_option === 'specify' ? 'Specify Requirements' : 'Choose Specific'}</span></div>`;
          if (this.formData.shape) html += `<div class="ai-custom-form-review-item-{{ ai_gen_id }}"><span class="ai-custom-form-review-label-{{ ai_gen_id }}">Shape</span><span class="ai-custom-form-review-value-{{ ai_gen_id }}">${this.formData.shape}</span></div>`;
          if (this.formData.carat) html += `<div class="ai-custom-form-review-item-{{ ai_gen_id }}"><span class="ai-custom-form-review-label-{{ ai_gen_id }}">Carat</span><span class="ai-custom-form-review-value-{{ ai_gen_id }}">${this.formData.carat} ct</span></div>`;
          if (this.formData.diamond_price) html += `<div class="ai-custom-form-review-item-{{ ai_gen_id }}"><span class="ai-custom-form-review-label-{{ ai_gen_id }}">Estimated Price</span><span class="ai-custom-form-review-value-{{ ai_gen_id }}">$${this.formData.diamond_price.toLocaleString()}</span></div>`;
          if (this.formData.min_carat) html += `<div class="ai-custom-form-review-item-{{ ai_gen_id }}"><span class="ai-custom-form-review-label-{{ ai_gen_id }}">Min Carat</span><span class="ai-custom-form-review-value-{{ ai_gen_id }}">${this.formData.min_carat}</span></div>`;
          if (this.formData.cut) html += `<div class="ai-custom-form-review-item-{{ ai_gen_id }}"><span class="ai-custom-form-review-label-{{ ai_gen_id }}">Cut</span><span class="ai-custom-form-review-value-{{ ai_gen_id }}">${this.formData.cut}</span></div>`;
          if (this.formData.color) html += `<div class="ai-custom-form-review-item-{{ ai_gen_id }}"><span class="ai-custom-form-review-label-{{ ai_gen_id }}">Color</span><span class="ai-custom-form-review-value-{{ ai_gen_id }}">${this.formData.color}</span></div>`;
          if (this.formData.clarity) html += `<div class="ai-custom-form-review-item-{{ ai_gen_id }}"><span class="ai-custom-form-review-label-{{ ai_gen_id }}">Clarity</span><span class="ai-custom-form-review-value-{{ ai_gen_id }}">${this.formData.clarity}</span></div>`;
          reviewStep2.innerHTML = html;
        }
      }

      setupReviewEditing() {
        const editLinks = this.querySelectorAll('[data-edit-step]');
        editLinks.forEach(link => {
          link.addEventListener('click', () => {
            const step = parseInt(link.getAttribute('data-edit-step'));
            this.showStep(step);
          });
        });
      }

      // Form Submission
      async submitFormData() {
        console.log('[FORM SUBMISSION] ========== STARTING FORM SUBMISSION ==========');
        this.collectFormData();
        
        const submitButton = this.querySelector('[data-submit-form]');
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'SUBMITTING...';
        }

        try {
          // Format all data as message
          let message = 'Custom Engagement Ring Request\n\n';
          message += '=== Design Details ===\n';
          message += `Description: ${this.formData.description || 'N/A'}\n`;
          message += `Metal Color: ${this.formData.metal_color || 'N/A'}\n`;
          message += `Ring Size: ${this.formData.ring_size || 'N/A'}\n`;
          message += `Image URL: ${this.formData.image_url || 'N/A'}\n`;
          message += `Files: ${this.formData.file1_name || ''} ${this.formData.file2_name || ''}\n\n`;
          
          message += '=== Diamond Specifications ===\n';
          message += `Option: ${this.formData.diamond_option || 'N/A'}\n`;
          message += `Shape: ${this.formData.shape || 'N/A'}\n`;
          message += `Carat: ${this.formData.carat || 'N/A'} ct\n`;
          message += `Estimated Price: $${(this.formData.diamond_price || 0).toLocaleString()}\n`;
          message += `Min Carat: ${this.formData.min_carat || 'N/A'}\n`;
          message += `Cut: ${this.formData.cut || 'N/A'}\n`;
          message += `Color: ${this.formData.color || 'N/A'}\n`;
          message += `Clarity: ${this.formData.clarity || 'N/A'}\n\n`;
          
          message += '=== Customer Information ===\n';
          message += `Name: ${this.formData.first_name || ''} ${this.formData.last_name || ''}\n`;
          message += `Phone: ${this.formData.phone || 'N/A'}\n`;
          message += `Reason: ${this.formData.reason || 'N/A'}\n`;
          message += `Date Needed: ${this.formData.date_needed || 'N/A'}\n`;
          
          console.log('[FORM SUBMISSION] Message to be sent:', message);

          // SOLUTION: Use Formspree or similar service to bypass CAPTCHA
          const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xkgpbkjn';
          const USE_FORMSPREE = true;
          
          console.log('[FORM SUBMISSION] Preparing submission...');
          console.log('[FORM SUBMISSION] Using Formspree:', USE_FORMSPREE);
          console.log('[FORM SUBMISSION] Endpoint:', FORMSPREE_ENDPOINT);
          
          if (USE_FORMSPREE) {
            // Use Formspree for production
            console.log('[FORM SUBMISSION] Submitting to Formspree...');
            
            const response = await fetch(FORMSPREE_ENDPOINT, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({
                email: this.formData.email,
                name: `${this.formData.first_name || ''} ${this.formData.last_name || ''}`.trim(),
                phone: this.formData.phone,
                message: message,
                // Individual fields for better organization
                description: this.formData.description,
                metal_color: this.formData.metal_color,
                ring_size: this.formData.ring_size,
                image_url: this.formData.image_url,
                file1: this.formData.file1_name,
                file2: this.formData.file2_name,
                diamond_option: this.formData.diamond_option,
                diamond_shape: this.formData.shape,
                diamond_carat: this.formData.carat,
                diamond_price: `$${(this.formData.diamond_price || 0).toLocaleString()}`,
                diamond_min_carat: this.formData.min_carat,
                diamond_cut: this.formData.cut,
                diamond_color: this.formData.color,
                diamond_clarity: this.formData.clarity,
                reason: this.formData.reason,
                date_needed: this.formData.date_needed,
                _subject: 'Custom Engagement Ring Request - Azalea Jewelry',
                _replyto: this.formData.email
              })
            });

            console.log('[FORM SUBMISSION] Response status:', response.status);
            
            if (response.ok) {
              console.log('[FORM SUBMISSION] ✅ SUCCESS! Form submitted via Formspree');
              this.clearLocalStorage();
              this.showStep(4);
            } else {
              const errorData = await response.json();
              console.error('[FORM SUBMISSION] Formspree error:', errorData);
              throw new Error('Formspree submission failed');
            }
            
          } else {
            // Fallback: Save locally and open email client
            console.log('[FORM SUBMISSION] Using fallback method (mailto)...');
            console.log('[FORM SUBMISSION] ⚠️ To enable automatic submission, set up Formspree:');
            console.log('[FORM SUBMISSION] 1. Go to https://formspree.io');
            console.log('[FORM SUBMISSION] 2. Create a form and get your form ID');
            console.log('[FORM SUBMISSION] 3. Replace YOUR_FORM_ID in the code');
            console.log('[FORM SUBMISSION] 4. Set USE_FORMSPREE = true');
            
            // Save submission data locally
            const submissionData = {
              timestamp: new Date().toISOString(),
              email: this.formData.email,
              name: `${this.formData.first_name || ''} ${this.formData.last_name || ''}`.trim(),
              phone: this.formData.phone,
              formData: this.formData,
              message: message
            };
            
            const submissions = JSON.parse(localStorage.getItem('customEngagementForm_submissions') || '[]');
            submissions.push(submissionData);
            localStorage.setItem('customEngagementForm_submissions', JSON.stringify(submissions));
            
            console.log('[FORM SUBMISSION] Submission saved locally:', submissionData);
            console.log('[FORM SUBMISSION] View all submissions: localStorage.getItem("customEngagementForm_submissions")');
            
            // Open email client as backup
            const emailTo = 'masumbinshaukat@gmail.com'; // ⚠️ Replace with your email
            const emailSubject = 'Custom Engagement Ring Request';
            const emailBody = encodeURIComponent(message);
            const mailtoLink = `mailto:${emailTo}?subject=${encodeURIComponent(emailSubject)}&body=${emailBody}`;
            
            try {
              const tempLink = document.createElement('a');
              tempLink.href = mailtoLink;
              tempLink.style.display = 'none';
              document.body.appendChild(tempLink);
              tempLink.click();
              document.body.removeChild(tempLink);
              console.log('[FORM SUBMISSION] Email client opened');
            } catch (e) {
              console.warn('[FORM SUBMISSION] Could not open email client:', e);
            }
            
            // Show success message
            console.log('[FORM SUBMISSION] ✅ SUCCESS! Showing thank you page...');
            this.clearLocalStorage();
            this.showStep(4);
          }
          
          console.log('[FORM SUBMISSION] Form submission complete!')
        } catch (error) {
          console.error('[FORM SUBMISSION] ❌ ERROR:', error);
          console.error('[FORM SUBMISSION] Error details:', {
            message: error.message,
            stack: error.stack
          });
          
          alert('There was an error submitting your request. Please try again or contact us directly.');
          
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.textContent = 'SUBMIT REQUEST';
          }
        }
        
        console.log('[FORM SUBMISSION] ========== FORM SUBMISSION COMPLETE ==========');
      }
    }

    customElements.define('custom-engagement-form-{{ ai_gen_id }}', CustomEngagementForm{{ ai_gen_id }});
  })();
</script>

