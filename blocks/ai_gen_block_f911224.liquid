{% doc %}
  @prompt
    Multi-step custom engagement ring form with 4 steps:
    Step 1: Upload images/URL, description, metal color, ring size
    Step 2: Diamond specifications (shape, carat, cut, color, clarity)
    Step 3: Review all data with edit links, user info form
    Step 4: Thank you message
    
    Pixel-perfect styling: #FFFFFF bg, #8B4513 accents, #000000 text, system-ui fonts
    Async progression with JavaScript (no page reloads)
    Data persistence via localStorage
    Dynamic price calculation based on carat
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-form-{{ ai_gen_id }} {
    background-color: #FFFFFF;
    width: 100%;
    font-family: system-ui, -apple-system, Arial, sans-serif;
  }

  .ai-custom-form-container-{{ ai_gen_id }} {
    max-width: 1100px;
    margin: 0 auto;
    padding: 60px 20px;
  }

  .ai-custom-form-breadcrumb-{{ ai_gen_id }} {
    font-size: 12px;
    color: #808080;
    margin-bottom: 40px;
    text-align: left;
  }

  /* Multi-step functionality */
  .ai-custom-form-step-{{ ai_gen_id }} {
    display: none;
  }

  .ai-custom-form-step-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-custom-form-section-{{ ai_gen_id }} {
    margin-bottom: 30px;
  }

  .ai-custom-form-icon-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border: 2px solid #CCCCCC;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 15px;
    color: #808080;
    font-size: 20px;
    font-weight: bold;
  }

  .ai-custom-form-icon-{{ ai_gen_id }}.complete {
    border-color: #8B4513;
    color: #8B4513;
  }

  .ai-custom-form-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: bold;
    color: #000000;
    margin: 0 0 12px 0;
  }

  .ai-custom-form-heading-{{ ai_gen_id }} {
    font-size: 28px;
    font-weight: bold;
    color: #000000;
    margin: 0 0 30px 0;
    text-align: center;
  }

  .ai-custom-form-note-{{ ai_gen_id }} {
    font-size: 12px;
    font-style: normal;
    color: #666666;
    margin-bottom: 8px;
    line-height: 1.5;
  }

  .ai-custom-form-note-regular-{{ ai_gen_id }} {
    font-size: 14px;
    color: #666666;
    margin-bottom: 15px;
    line-height: 1.5;
  }

  .ai-custom-form-note-regular-{{ ai_gen_id }} a {
    color: #8B4513;
    text-decoration: underline;
  }

  .ai-custom-form-field-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-custom-form-label-{{ ai_gen_id }} {
    font-size: 16px;
    color: #000000;
    display: block;
    margin-bottom: 8px;
    font-weight: 500;
  }

  .ai-custom-form-input-{{ ai_gen_id }},
  .ai-custom-form-textarea-{{ ai_gen_id }},
  .ai-custom-form-select-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 15px;
    font-size: 16px;
    border: 1px solid #CCCCCC;
    font-family: system-ui, -apple-system, Arial, sans-serif;
    box-sizing: border-box;
    border-radius: 4px;
  }

  .ai-custom-form-input-{{ ai_gen_id }}:focus,
  .ai-custom-form-textarea-{{ ai_gen_id }}:focus,
  .ai-custom-form-select-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: #8B4513;
  }

  .ai-custom-form-textarea-{{ ai_gen_id }} {
    height: 200px;
    resize: vertical;
  }

  .ai-custom-form-file-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .ai-custom-form-file-input-{{ ai_gen_id }} {
    flex: 1;
    padding: 12px 15px;
    font-size: 14px;
    border: 1px solid #CCCCCC;
    font-family: system-ui, -apple-system, Arial, sans-serif;
    border-radius: 4px;
  }

  .ai-custom-form-file-button-{{ ai_gen_id }} {
    background-color: #8B4513;
    color: #FFFFFF;
    border: none;
    padding: 12px 24px;
    font-size: 18px;
    cursor: pointer;
    font-family: system-ui, -apple-system, Arial, sans-serif;
    border-radius: 4px;
    font-weight: bold;
    transition: background-color 0.2s ease;
  }

  .ai-custom-form-file-button-{{ ai_gen_id }}:hover {
    background-color: #6B3410;
  }

  .ai-custom-form-file-preview-{{ ai_gen_id }} {
    font-size: 12px;
    color: #808080;
    margin-top: 5px;
  }

  .ai-custom-form-file-preview-{{ ai_gen_id }} img {
    max-width: 100px;
    max-height: 100px;
    margin-top: 10px;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
  }

  .ai-custom-form-divider-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    margin: 30px 0;
  }

  .ai-custom-form-divider-line-{{ ai_gen_id }} {
    flex: 1;
    height: 1px;
    background-color: #E0E0E0;
  }

  .ai-custom-form-divider-text-{{ ai_gen_id }} {
    padding: 0 20px;
    font-size: 14px;
    color: #808080;
    font-weight: 500;
  }

  .ai-custom-form-metal-options-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 15px;
  }

  .ai-custom-form-metal-option-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }

  .ai-custom-form-metal-circle-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 2px solid #DDDDDD;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-bottom: 5px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-custom-form-metal-circle-{{ ai_gen_id }}::before {
    content: '';
    width: 34px;
    height: 34px;
    border-radius: 50%;
    position: absolute;
  }

  .ai-custom-form-metal-circle-{{ ai_gen_id }}.white {
    background-color: #F8F8F8;
  }

  .ai-custom-form-metal-circle-{{ ai_gen_id }}.white::before {
    background-color: #F5F5F5;
    border: 1px solid #E0E0E0;
  }

  .ai-custom-form-metal-circle-{{ ai_gen_id }}.yellow {
    background-color: #FFF9E6;
  }

  .ai-custom-form-metal-circle-{{ ai_gen_id }}.yellow::before {
    background-color: #FFD700;
  }

  .ai-custom-form-metal-circle-{{ ai_gen_id }}.rose {
    background-color: #FFF0F3;
  }

  .ai-custom-form-metal-circle-{{ ai_gen_id }}.rose::before {
    background-color: #FFC0CB;
  }

  .ai-custom-form-metal-circle-{{ ai_gen_id }}.platinum {
    background-color: #F5F5F5;
  }

  .ai-custom-form-metal-circle-{{ ai_gen_id }}.platinum::before {
    background-color: #E5E4E2;
    border: 1px solid #D0D0D0;
  }

  .ai-custom-form-metal-circle-{{ ai_gen_id }}.selected {
    border: 3px solid #8B4513;
    box-shadow: 0 0 0 3px rgba(139, 69, 19, 0.15);
  }

  .ai-custom-form-metal-label-{{ ai_gen_id }} {
    font-size: 12px;
    color: #000;
    text-align: center;
  }

  .ai-custom-form-metal-input-{{ ai_gen_id }} {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .ai-custom-form-link-{{ ai_gen_id }} {
    color: #8B4513;
    text-decoration: underline;
    font-size: 14px;
    display: inline-block;
    margin-top: 10px;
    cursor: pointer;
  }

  .ai-custom-form-link-{{ ai_gen_id }}:hover {
    color: #6B3410;
  }

  .ai-custom-form-button-group-{{ ai_gen_id }} {
    display: flex;
    gap: 15px;
    justify-content: center;
    margin-top: 40px;
  }

  .ai-custom-form-submit-{{ ai_gen_id }},
  .ai-custom-form-button-{{ ai_gen_id }} {
    background-color: #000000;
    color: #FFFFFF;
    border: none;
    padding: 15px 50px;
    font-size: 16px;
    font-weight: bold;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-block;
    font-family: system-ui, -apple-system, Arial, sans-serif;
    border-radius: 0;
    min-width: 200px;
    transition: background-color 0.2s ease;
  }

  .ai-custom-form-submit-{{ ai_gen_id }}:hover,
  .ai-custom-form-button-{{ ai_gen_id }}:hover {
    background-color: #333333;
  }

  .ai-custom-form-button-{{ ai_gen_id }}.secondary {
    background-color: #FFFFFF;
    color: #000000;
    border: 2px solid #000000;
  }

  .ai-custom-form-button-{{ ai_gen_id }}.secondary:hover {
    background-color: #F5F5F5;
  }

  .ai-custom-form-success-{{ ai_gen_id }} {
    background-color: #d4edda;
    color: #155724;
    padding: 15px;
    margin-bottom: 20px;
    border: 1px solid #c3e6cb;
    font-size: 14px;
  }

  .ai-custom-form-error-{{ ai_gen_id }} {
    background-color: #f8d7da;
    color: #721c24;
    padding: 15px;
    margin-bottom: 20px;
    border: 1px solid #f5c6cb;
    font-size: 14px;
    border-radius: 4px;
  }

  /* Step 2 - Diamond Specifications */
  .ai-custom-form-diamond-options-{{ ai_gen_id }} {
    display: flex;
    gap: 30px;
    margin-bottom: 40px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .ai-custom-form-diamond-option-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
  }

  .ai-custom-form-diamond-option-{{ ai_gen_id }} input[type="radio"] {
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  .ai-custom-form-diamond-option-{{ ai_gen_id }} label {
    font-size: 16px;
    color: #000000;
    cursor: pointer;
  }

  .ai-custom-form-diamond-option-{{ ai_gen_id }}.selected label {
    color: #8B4513;
    font-weight: bold;
  }

  .ai-custom-form-diamond-display-{{ ai_gen_id }} {
    text-align: center;
    margin: 40px 0;
  }

  .ai-custom-form-diamond-display-{{ ai_gen_id }} h3 {
    font-size: 20px;
    font-weight: bold;
    color: #000000;
    margin-bottom: 20px;
  }

  .ai-custom-form-diamond-image-{{ ai_gen_id }} {
    width: 150px;
    height: 150px;
    margin: 0 auto 20px;
  }

  .ai-custom-form-diamond-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-custom-form-diamond-info-{{ ai_gen_id }} {
    font-size: 18px;
    color: #000000;
    margin-bottom: 10px;
  }

  .ai-custom-form-diamond-info-{{ ai_gen_id }} strong {
    font-weight: bold;
  }

  .ai-custom-form-shape-selector-{{ ai_gen_id }} {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
    margin: 30px 0;
  }

  .ai-custom-form-shape-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    padding: 10px;
    border: 2px solid transparent;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .ai-custom-form-shape-item-{{ ai_gen_id }}.selected {
    border-color: #8B4513;
    background-color: #FFF8F0;
  }

  .ai-custom-form-shape-item-{{ ai_gen_id }} img {
    width: 50px;
    height: 50px;
    object-fit: contain;
  }

  .ai-custom-form-shape-item-{{ ai_gen_id }} span {
    font-size: 12px;
    color: #000000;
    text-align: center;
  }

  .ai-custom-form-carat-slider-{{ ai_gen_id }} {
    margin: 30px 0;
  }

  .ai-custom-form-carat-slider-{{ ai_gen_id }} label {
    font-size: 16px;
    font-weight: bold;
    color: #000000;
    display: block;
    margin-bottom: 15px;
  }

  .ai-custom-form-carat-values-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .ai-custom-form-carat-value-{{ ai_gen_id }} {
    padding: 10px 20px;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
    color: #000000;
    transition: all 0.2s ease;
    text-align: center;
    flex: 1;
    min-width: 80px;
  }

  .ai-custom-form-carat-value-{{ ai_gen_id }}.selected {
    border-color: #8B4513;
    background-color: #8B4513;
    color: #FFFFFF;
    font-weight: bold;
  }

  .ai-custom-form-two-column-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 40px;
  }

  .ai-custom-form-requirements-panel-{{ ai_gen_id }} {
    background-color: #F9F9F9;
    padding: 30px;
    border-radius: 8px;
  }

  .ai-custom-form-requirements-panel-{{ ai_gen_id }} h4 {
    font-size: 18px;
    font-weight: bold;
    color: #000000;
    margin-bottom: 20px;
  }

  /* Step 3 - Review */
  .ai-custom-form-review-section-{{ ai_gen_id }} {
    background-color: #F9F9F9;
    padding: 30px;
    border-radius: 8px;
    margin-bottom: 30px;
  }

  .ai-custom-form-review-section-{{ ai_gen_id }} h3 {
    font-size: 20px;
    font-weight: bold;
    color: #000000;
    margin-bottom: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .ai-custom-form-edit-link-{{ ai_gen_id }} {
    font-size: 14px;
    color: #8B4513;
    text-decoration: underline;
    cursor: pointer;
    font-weight: normal;
  }

  .ai-custom-form-review-item-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid #E0E0E0;
  }

  .ai-custom-form-review-item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-custom-form-review-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: #666666;
    font-weight: 500;
  }

  .ai-custom-form-review-value-{{ ai_gen_id }} {
    font-size: 14px;
    color: #000000;
    font-weight: bold;
    text-align: right;
  }

  .ai-custom-form-checkbox-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 20px 0;
  }

  .ai-custom-form-checkbox-wrapper-{{ ai_gen_id }} input[type="checkbox"] {
    width: 18px;
    height: 18px;
    margin-top: 2px;
    cursor: pointer;
  }

  .ai-custom-form-checkbox-wrapper-{{ ai_gen_id }} label {
    font-size: 14px;
    color: #000000;
    cursor: pointer;
    line-height: 1.5;
  }

  /* Step 4 - Thank You */
  .ai-custom-form-thank-you-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
  }

  .ai-custom-form-thank-you-{{ ai_gen_id }} h2 {
    font-size: 32px;
    font-weight: bold;
    color: #000000;
    margin-bottom: 30px;
  }

  .ai-custom-form-thank-you-{{ ai_gen_id }} p {
    font-size: 16px;
    color: #666666;
    line-height: 1.8;
    max-width: 700px;
    margin: 0 auto 40px;
  }

  @media screen and (max-width: 767px) {
    .ai-custom-form-container-{{ ai_gen_id }} {
      padding: 30px 15px;
    }

    .ai-custom-form-heading-{{ ai_gen_id }} {
      font-size: 22px;
    }

    .ai-custom-form-title-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-custom-form-section-{{ ai_gen_id }} {
      margin-bottom: 25px;
    }

    .ai-custom-form-metal-options-{{ ai_gen_id }} {
      gap: 12px;
    }

    .ai-custom-form-file-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: stretch;
    }

    .ai-custom-form-button-group-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-custom-form-submit-{{ ai_gen_id }},
    .ai-custom-form-button-{{ ai_gen_id }} {
      width: 100%;
      min-width: auto;
    }

    .ai-custom-form-two-column-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-custom-form-shape-selector-{{ ai_gen_id }} {
      gap: 10px;
    }

    .ai-custom-form-carat-values-{{ ai_gen_id }} {
      gap: 8px;
    }

    .ai-custom-form-carat-value-{{ ai_gen_id }} {
      padding: 8px 12px;
      font-size: 12px;
      min-width: 60px;
    }

    .ai-custom-form-diamond-options-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 15px;
      align-items: flex-start;
    }
  }
{% endstyle %}

<custom-engagement-form-{{ ai_gen_id }} class="ai-custom-form-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-custom-form-container-{{ ai_gen_id }}">
    <div class="ai-custom-form-breadcrumb-{{ ai_gen_id }}">
      {{ block.settings.breadcrumb_text }}
    </div>

    <!-- Step 1: Upload & Basic Info -->
    <div class="ai-custom-form-step-{{ ai_gen_id }} active" data-step="1">
      
      <!-- Upload Section - Two Column Layout -->
      <div class="ai-custom-form-two-column-{{ ai_gen_id }}" style="margin-bottom: 50px;">
        <div>
          <div class="ai-custom-form-icon-{{ ai_gen_id }}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
          </div>
          <h2 class="ai-custom-form-title-{{ ai_gen_id }}">{{ block.settings.upload_title }}</h2>
          <div class="ai-custom-form-note-{{ ai_gen_id }}">{{ block.settings.upload_note_1 }}</div>
          <div class="ai-custom-form-note-{{ ai_gen_id }}">{{ block.settings.upload_note_2 }}</div>
          <div class="ai-custom-form-note-{{ ai_gen_id }}">{{ block.settings.upload_note_3 }}</div>
        </div>

        <div>
          <div class="ai-custom-form-field-{{ ai_gen_id }}">
            <label class="ai-custom-form-label-{{ ai_gen_id }}">{{ block.settings.picture_label }}*</label>
            <div style="display: flex; gap: 15px; align-items: flex-start;">
              <div style="flex: 1;">
                <div class="ai-custom-form-file-wrapper-{{ ai_gen_id }}">
                  <input
                    type="file"
                    id="file-input-1-{{ ai_gen_id }}"
                    class="ai-custom-form-file-input-{{ ai_gen_id }}"
                    accept=".jpg,.jpeg,.png,.webp"
                    data-file-input="1"
                  >
                  <button type="button" class="ai-custom-form-file-button-{{ ai_gen_id }}" data-file-trigger="1">+</button>
                </div>
                <div class="ai-custom-form-file-preview-{{ ai_gen_id }}" data-file-preview="1"></div>
                <div class="ai-custom-form-note-{{ ai_gen_id }}" style="margin-top: 5px; text-align: center;">View 1*</div>
              </div>
              
              <div style="flex: 1;">
                <div class="ai-custom-form-file-wrapper-{{ ai_gen_id }}">
                  <input
                    type="file"
                    id="file-input-2-{{ ai_gen_id }}"
                    class="ai-custom-form-file-input-{{ ai_gen_id }}"
                    accept=".jpg,.jpeg,.png,.webp"
                    data-file-input="2"
                  >
                  <button type="button" class="ai-custom-form-file-button-{{ ai_gen_id }}" data-file-trigger="2">+</button>
                </div>
                <div class="ai-custom-form-file-preview-{{ ai_gen_id }}" data-file-preview="2"></div>
                <div class="ai-custom-form-note-{{ ai_gen_id }}" style="margin-top: 5px; text-align: center;">View 2</div>
              </div>
            </div>
          </div>

          <div class="ai-custom-form-divider-{{ ai_gen_id }}">
            <div class="ai-custom-form-divider-line-{{ ai_gen_id }}"></div>
            <div class="ai-custom-form-divider-text-{{ ai_gen_id }}">OR</div>
            <div class="ai-custom-form-divider-line-{{ ai_gen_id }}"></div>
          </div>

          <div class="ai-custom-form-field-{{ ai_gen_id }}">
            <label class="ai-custom-form-label-{{ ai_gen_id }}">{{ block.settings.url_label }}</label>
            <input
              type="url"
              id="image-url-{{ ai_gen_id }}"
              class="ai-custom-form-input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.url_placeholder }}"
              data-field="image_url"
            >
          </div>
        </div>
      </div>

      <!-- Tell Us More Section - Two Column Layout -->
      <div class="ai-custom-form-two-column-{{ ai_gen_id }}" style="margin-bottom: 50px;">
        <div>
          <div class="ai-custom-form-icon-{{ ai_gen_id }}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          </div>
          <h2 class="ai-custom-form-title-{{ ai_gen_id }}">{{ block.settings.description_title }}</h2>
