

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}



{% style %}
  .ai-product-showcase-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-showcase-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-product-showcase-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: 32px;
  }

  .ai-product-showcase-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background_color }};
    border-radius: 8px;
    text-align: center;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-product-showcase-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-product-showcase-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 300px;
    margin-bottom: 16px;
    overflow: hidden;
  }

  .ai-product-showcase-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .ai-product-showcase-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-product-showcase-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.5;
  }

 .ai-product-showcase-color-swatch-{{ ai_gen_id }} {
  position: relative;
  overflow: hidden;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid #ddd;
  cursor: pointer;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

/* glossy highlight overlay */
.ai-product-showcase-color-swatch-{{ ai_gen_id }}::after {
  content: "";
  position: absolute;
  top: -40%;
  left: -40%;
  width: 180%;
  height: 180%;
  background: linear-gradient(
    120deg,
    rgba(255, 255, 255, 0.7) 0%,
    rgba(255, 255, 255, 0) 60%
  );
  transform: rotate(25deg);
  pointer-events: none;
}

.ai-product-showcase-color-swatch-{{ ai_gen_id }}:hover {
  transform: scale(1.15);
  border-color: #222;
}

.ai-product-showcase-color-swatch-{{ ai_gen_id }}.active {
  border-color: {{ block.settings.accent_color }};
  box-shadow: 0 0 6px rgba(0, 0, 0, 0.25);
}

  .ai-product-showcase-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .ai-product-showcase-price-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 200;
    color: {{ block.settings.price_color }};
    margin: 0;
  }

  .ai-product-showcase-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-product-showcase-empty-state-{{ ai_gen_id }} h3 {
    font-size: 24px;
    margin-bottom: 12px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-showcase-empty-state-{{ ai_gen_id }} p {
    font-size: 16px;
    margin: 0;
  }

 .ai-product-showcase-color-swatch-{{ ai_gen_id }} {
  position: relative;
  overflow: hidden;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid #ddd;
  cursor: pointer;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  background-size: cover !important;
  background-position: center;
}

/* glossy highlight */
.ai-product-showcase-color-swatch-{{ ai_gen_id }}::after {
  content: "";
  position: absolute;
  top: -40%;
  left: -40%;
  width: 180%;
  height: 180%;
  background: linear-gradient(
    120deg,
    rgba(255, 255, 255, 0.6) 0%,
    rgba(255, 255, 255, 0) 60%
  );
  transform: rotate(25deg);
  pointer-events: none;
}

/* hover effect */
.ai-product-showcase-color-swatch-{{ ai_gen_id }}:hover {
  transform: scale(1.15);
  border-color: #222;
}

/* active state */
.ai-product-showcase-color-swatch-{{ ai_gen_id }}.active {
  border-color: {{ block.settings.accent_color }};
  box-shadow: 0 0 5px rgba(0, 0, 0, 0.3);
}


  @media screen and (max-width: 990px) {
    .ai-product-showcase-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-showcase-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .ai-product-showcase-card-{{ ai_gen_id }} {
      padding: 16px;
    }

    .ai-product-showcase-image-container-{{ ai_gen_id }} {
      height: 160px;
    }

    .ai-product-showcase-title-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-product-showcase-price-{{ ai_gen_id }} {
      font-size: 16px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-product-showcase-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }


  /* Desktop grid */
.ai-product-showcase-grid-{{ ai_gen_id }} {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px; /* normal gap on desktop */
}

.ai-product-showcase-card-{{ ai_gen_id }} {
  text-align: center;
  padding: 10px;
}

.ai-product-showcase-image-{{ ai_gen_id }} {
  width: 100%;  /* full size in desktop */
  height: auto;
  object-fit: contain;
}

.ai-product-showcase-color-swatch-{{ ai_gen_id }} {
  width: 28px;   /* normal size */
  height: 28px;
  border-radius: 50%;
  border: 1px solid #ddd;
  cursor: pointer;
  transition: transform 0.2s, border 0.2s;
}

.ai-product-showcase-color-swatch-{{ ai_gen_id }}:hover,
.ai-product-showcase-color-swatch-{{ ai_gen_id }}.active {
  transform: scale(1.1);
  border: 1px solid #000;
}

/* Responsive - tablet */
@media screen and (max-width: 1024px) {
  .ai-product-showcase-grid-{{ ai_gen_id }} {
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
}

/* Responsive - mobile */
@media screen and (max-width: 749px) {
  .ai-product-showcase-grid-{{ ai_gen_id }} {
    grid-template-columns: repeat(2, 1fr); /* 2 cards in mobile */
    gap: 8px; /* reduced gap */
  }

  .ai-product-showcase-image-{{ ai_gen_id }} {
    width: 100%;   /* shrink image */
    height: 100%;  /* shrink image */
  }

  .ai-product-showcase-color-swatch-{{ ai_gen_id }} {
    width: 16px;  /* smaller circles */
    height: 16px;
  }
}


{% endstyle %}

<product-showcase-{{ ai_gen_id }}
  class="ai-product-showcase-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-showcase-container-{{ ai_gen_id }}">
    {% assign has_products = false %}
    {% for i in (1..60) %}
      {% liquid
        assign product_key = 'product_' | append: i
        assign product = block.settings[product_key]
        if product != blank
          assign has_products = true
          break
        endif
      %}
    {% endfor %}

    {% if has_products %}
      <div class="ai-product-showcase-grid-{{ ai_gen_id }}">
        {% for i in (1..60) %}
          {% liquid
            assign product_key = 'product_' | append: i
            assign product = block.settings[product_key]
          %}

          {% if product != blank %}
            <div
              class="ai-product-showcase-card-{{ ai_gen_id }}"
              data-product-id="{{ product.id }}"
              data-product-url="{{ product.url }}"
            >
              <div class="ai-product-showcase-image-container-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 400 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-product-showcase-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="400"
                    height="400"
                    data-main-image
                  >
                {% else %}
                  <div class="ai-product-showcase-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

  {% if product.variants.size > 1 %}
  <div class="ai-product-showcase-color-swatches-{{ ai_gen_id }}">
    {% assign variant_count = 0 %}
    {% for variant in product.variants limit: 4 %}
      {% if variant.featured_image %}
        {% assign variant_count = variant_count | plus: 1 %}
        {% assign swatch_color = variant.option1 | downcase %}
        {% assign color_value = '#cccccc' %}
        
          {% if swatch_color contains 'rose gold' %}
                        {% assign color_value = 'linear-gradient(135deg, #FAD6C3 10%, #EFB7A3 40%, #D9A29C 90%)' %}
                      {% elsif swatch_color contains 'gold' %}
                        {% assign color_value = 'linear-gradient(135deg, #F2DBA3 10%, #FAF8F3 50%, #D4AF37 90%)' %}
                      {% elsif swatch_color contains 'silver' %}
                        {% assign color_value = 'linear-gradient(135deg, #E0E0E0 10%, #F8F8F8 50%, #C0C0C0 90%)' %}
                      {% elsif swatch_color contains 'copper' %}
                        {% assign color_value = 'linear-gradient(135deg, #DDCDBE 15%, #FAF8F7 45%, #DFCEC8 85%)' %}
                      {% endif %}

        <button
          class="ai-product-showcase-color-swatch-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          style="background: {{ color_value }};"
          data-variant-id="{{ variant.id }}"
          data-variant-image="{{ variant.featured_image | image_url: width: 400 }}"
          data-variant-title="{{ variant.title | escape }}"
          data-variant-price="{{ variant.price | money }}"
          aria-label="Select {{ variant.title }}"
        ></button>
      {% endif %}
    {% endfor %}
  </div>
{% endif %}


                      <h3 class="ai-product-showcase-title-{{ ai_gen_id }}" data-product-title>
                        {{ product.title }}
                      </h3>

                      <p class="ai-product-showcase-price-{{ ai_gen_id }}" data-product-price>
                        {{ product.price | money }}
                      </p>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            {% else %}
              <div class="ai-product-showcase-empty-state-{{ ai_gen_id }}">
                <h3>Product Showcase</h3>
                <p>Add products to start building your showcase</p>
              </div>
            {% endif %}
          </div>
</product-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupEventListeners();
      }

      setupEventListeners() {
        const cards = this.querySelectorAll('.ai-product-showcase-card-{{ ai_gen_id }}');
        
        cards.forEach(card => {
          const swatches = card.querySelectorAll('.ai-product-showcase-color-swatch-{{ ai_gen_id }}');
          const mainImage = card.querySelector('[data-main-image]');
          const titleElement = card.querySelector('[data-product-title]');
          const priceElement = card.querySelector('[data-product-price]');

          swatches.forEach(swatch => {
            swatch.addEventListener('click', (e) => {
              e.stopPropagation();
              
              swatches.forEach(s => s.classList.remove('active'));
              swatch.classList.add('active');

              const variantImage = swatch.dataset.variantImage;
              const variantTitle = swatch.dataset.variantTitle;
              const variantPrice = swatch.dataset.variantPrice;

              if (mainImage && variantImage) {
                mainImage.src = variantImage;
              }

              if (titleElement && variantTitle) {
                const baseTitle = titleElement.textContent.split(' - ')[0];
                titleElement.textContent = baseTitle + ' - ' + variantTitle;
              }

              if (priceElement && variantPrice) {
                priceElement.textContent = variantPrice;
              }
            });
          });

          card.addEventListener('click', () => {
            const productUrl = card.dataset.productUrl;
            if (productUrl) {
              window.location.href = productUrl;
            }
          });
        });
      }
    }
  

    customElements.define('product-showcase-{{ ai_gen_id }}', ProductShowcase{{ ai_gen_id }});
  })();
</script>

