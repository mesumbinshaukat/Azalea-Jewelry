

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}



{% style %}
  .ai-product-showcase-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-showcase-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-product-showcase-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: 32px;
  }

  .ai-product-showcase-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background_color }};
    border-radius: 8px;
    text-align: center;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-product-showcase-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-product-showcase-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 300px;
    margin-bottom: 16px;
    overflow: hidden;
  }

  .ai-product-showcase-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .ai-product-showcase-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-product-showcase-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.5;
  }

 .ai-product-showcase-color-swatch-{{ ai_gen_id }} {
  position: relative;
  overflow: hidden;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid #ddd;
  cursor: pointer;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

/* glossy highlight overlay */
.ai-product-showcase-color-swatch-{{ ai_gen_id }}::after {
  content: "";
  position: absolute;
  top: -40%;
  left: -40%;
  width: 180%;
  height: 180%;
  background: linear-gradient(
    120deg,
    rgba(255, 255, 255, 0.7) 0%,
    rgba(255, 255, 255, 0) 60%
  );
  transform: rotate(25deg);
  pointer-events: none;
}

.ai-product-showcase-color-swatch-{{ ai_gen_id }}:hover {
  transform: scale(1.15);
  border-color: #222;
}

.ai-product-showcase-color-swatch-{{ ai_gen_id }}.active {
  border-color: {{ block.settings.accent_color }};
  box-shadow: 0 0 6px rgba(0, 0, 0, 0.25);
}

  .ai-product-showcase-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .ai-product-showcase-price-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 200;
    color: {{ block.settings.price_color }};
    margin: 0;
  }

  .ai-product-showcase-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-product-showcase-empty-state-{{ ai_gen_id }} h3 {
    font-size: 24px;
    margin-bottom: 12px;
    color: {{ block.settings.text_color }};
  }

  .ai-product-showcase-empty-state-{{ ai_gen_id }} p {
    font-size: 16px;
    margin: 0;
  }

 .ai-product-showcase-color-swatch-{{ ai_gen_id }} {
  position: relative;
  overflow: hidden;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid #ddd;
  cursor: pointer;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  background-size: cover !important;
  background-position: center;
}

/* glossy highlight */
.ai-product-showcase-color-swatch-{{ ai_gen_id }}::after {
  content: "";
  position: absolute;
  top: -40%;
  left: -40%;
  width: 180%;
  height: 180%;
  background: linear-gradient(
    120deg,
    rgba(255, 255, 255, 0.6) 0%,
    rgba(255, 255, 255, 0) 60%
  );
  transform: rotate(25deg);
  pointer-events: none;
}

/* hover effect */
.ai-product-showcase-color-swatch-{{ ai_gen_id }}:hover {
  transform: scale(1.15);
  border-color: #222;
}

/* active state */
.ai-product-showcase-color-swatch-{{ ai_gen_id }}.active {
  border-color: {{ block.settings.accent_color }};
  box-shadow: 0 0 5px rgba(0, 0, 0, 0.3);
}


  @media screen and (max-width: 990px) {
    .ai-product-showcase-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-showcase-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .ai-product-showcase-card-{{ ai_gen_id }} {
      padding: 16px;
    }

    .ai-product-showcase-image-container-{{ ai_gen_id }} {
      height: 160px;
    }

    .ai-product-showcase-title-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-product-showcase-price-{{ ai_gen_id }} {
      font-size: 16px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-product-showcase-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }


  /* Desktop grid */
.ai-product-showcase-grid-{{ ai_gen_id }} {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px; /* normal gap on desktop */
}

.ai-product-showcase-card-{{ ai_gen_id }} {
  text-align: center;
  padding: 10px;
}

.ai-product-showcase-image-{{ ai_gen_id }} {
  width: 100%;  /* full size in desktop */
  height: auto;
  object-fit: contain;
}

.ai-product-showcase-color-swatch-{{ ai_gen_id }} {
  width: 28px;   /* normal size */
  height: 28px;
  border-radius: 50%;
  border: 1px solid #ddd;
  cursor: pointer;
  transition: transform 0.2s, border 0.2s;
}

.ai-product-showcase-color-swatch-{{ ai_gen_id }}:hover,
.ai-product-showcase-color-swatch-{{ ai_gen_id }}.active {
  transform: scale(1.1);
  border: 1px solid #000;
}

/* Responsive - tablet */
@media screen and (max-width: 1024px) {
  .ai-product-showcase-grid-{{ ai_gen_id }} {
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
}

/* Responsive - mobile */
@media screen and (max-width: 749px) {
  .ai-product-showcase-grid-{{ ai_gen_id }} {
    grid-template-columns: repeat(2, 1fr); /* 2 cards in mobile */
    gap: 8px; /* reduced gap */
  }

  .ai-product-showcase-image-{{ ai_gen_id }} {
    width: 100%;   /* shrink image */
    height: 100%;  /* shrink image */
  }

  .ai-product-showcase-color-swatch-{{ ai_gen_id }} {
    width: 16px;  /* smaller circles */
    height: 16px;
  }
}


{% endstyle %}

<product-showcase-{{ ai_gen_id }}
  class="ai-product-showcase-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-showcase-container-{{ ai_gen_id }}">
    {% if collection.products_count > 0 %}
      <div class="ai-product-showcase-grid-{{ ai_gen_id }}" data-showcase-grid>
        {% for product in collection.products %}
          {% assign product_style = '' %}
          {% assign product_custom_meta = product.metafields.custom.custom %}
          {% if product_custom_meta != blank and product_custom_meta.value != blank %}
            {% assign product_style_reference = product_custom_meta.value.style %}
            {% if product_style_reference != blank and product_style_reference.value != blank %}
              {% assign product_style = product_style_reference.value %}
            {% endif %}
          {% endif %}

          <div
            class="ai-product-showcase-card-{{ ai_gen_id }}"
            data-product-id="{{ product.id }}"
            data-product-url="{{ product.url }}"
            data-style="{{ product_style | escape }}"
          >
            <div class="ai-product-showcase-image-container-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 300 }}"
                  alt="{{ product.title | escape }}"
                  class="ai-product-showcase-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="300"
                  height="300"
                  data-main-image
                >
              {% else %}
                <div class="ai-product-showcase-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if product.variants.size > 1 %}
              <div class="ai-product-showcase-color-swatches-{{ ai_gen_id }}">
                {% assign variant_count = 0 %}
                {% for variant in product.variants limit: 4 %}
                  {% if variant.featured_image %}
                    {% assign variant_count = variant_count | plus: 1 %}
                    {% assign swatch_color = variant.option1 | downcase %}
                    {% assign color_value = '#cccccc' %}

                    {% if swatch_color contains 'rose gold' %}
                      {% assign color_value = 'linear-gradient(135deg, #FAD6C3 10%, #EFB7A3 40%, #D9A29C 90%)' %}
                    {% elsif swatch_color contains 'gold' %}
                      {% assign color_value = 'linear-gradient(135deg, #F2DBA3 10%, #FAF8F3 50%, #D4AF37 90%)' %}
                    {% elsif swatch_color contains 'silver' %}
                      {% assign color_value = 'linear-gradient(135deg, #E0E0E0 10%, #F8F8F8 50%, #C0C0C0 90%)' %}
                    {% elsif swatch_color contains 'copper' %}
                      {% assign color_value = 'linear-gradient(135deg, #DDCDBE 15%, #FAF8F7 45%, #DFCEC8 85%)' %}
                    {% endif %}

                    <button
                      class="ai-product-showcase-color-swatch-{{ ai_gen_id }}"
                      style="background: {{ color_value }}"
                      data-variant-image="{{ variant.featured_image | image_url: width: 400 }}"
                      data-variant-title="{{ variant.title | escape }}"
                      data-variant-price="{{ variant.price | money }}"
                      type="button"
                    ></button>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            <h3 class="ai-product-showcase-title-{{ ai_gen_id }}" data-product-title>
              {{ product.title }}
            </h3>

            <p class="ai-product-showcase-price-{{ ai_gen_id }}" data-product-price>
              {{ product.price | money }}
            </p>
          </div>
        {% endfor %}
      </div>

      <div class="ai-product-showcase-empty-state-{{ ai_gen_id }}" data-empty-state hidden>
        <h3>No products found</h3>
        <p>No products found for this style.</p>
      </div>
    {% else %}
      <div class="ai-product-showcase-empty-state-{{ ai_gen_id }}">
        <h3>No products found</h3>
        <p>No products found for this style.</p>
      </div>
    {% endif %}
  </div>
</product-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.handleStyleFilter = this.handleStyleFilter.bind(this);
        this.handlePopState = this.handlePopState.bind(this);
      }

      connectedCallback() {
        this.grid = this.querySelector('[data-showcase-grid]');
        this.cards = Array.from(this.querySelectorAll('.ai-product-showcase-card-{{ ai_gen_id }}'));
        this.emptyState = this.querySelector('[data-empty-state]');

        // this.logAvailableStyles();

        this.setupEventListeners();
        this.applyStyleFromUrl();

        window.addEventListener('style:filter', this.handleStyleFilter);
        window.addEventListener('popstate', this.handlePopState);
      }

      disconnectedCallback() {
        window.removeEventListener('style:filter', this.handleStyleFilter);
        window.removeEventListener('popstate', this.handlePopState);
      }

      setupEventListeners() {
        this.cards.forEach(card => {
          const swatches = card.querySelectorAll('.ai-product-showcase-color-swatch-{{ ai_gen_id }}');
          const mainImage = card.querySelector('[data-main-image]');
          const titleElement = card.querySelector('[data-product-title]');
          const priceElement = card.querySelector('[data-product-price]');

          swatches.forEach(swatch => {
            swatch.addEventListener('click', (e) => {
              e.stopPropagation();
              
              swatches.forEach(s => s.classList.remove('active'));
              swatch.classList.add('active');

              const variantImage = swatch.dataset.variantImage;
              const variantTitle = swatch.dataset.variantTitle;
              const variantPrice = swatch.dataset.variantPrice;

              if (mainImage && variantImage) {
                mainImage.src = variantImage;
              }

              if (titleElement && variantTitle) {
                const baseTitle = titleElement.textContent.split(' - ')[0];
                titleElement.textContent = baseTitle + ' - ' + variantTitle;
              }

              if (priceElement && variantPrice) {
                priceElement.textContent = variantPrice;
              }
            });
          });

          card.addEventListener('click', () => {
            const productUrl = card.dataset.productUrl;
            if (productUrl) {
              window.location.href = productUrl;
            }
          });
        });
      }

      handleStyleFilter(event) {
        const style = event.detail && event.detail.style ? event.detail.style : '';
        this.applyStyleFilter(style);
      }

      applyStyleFromUrl() {
        const url = new URL(window.location.href);
        const selectedStyle = url.searchParams.get('filter.p.m.custom.style') || '';
        this.applyStyleFilter(selectedStyle);
      }

      handlePopState() {
        this.applyStyleFromUrl();
      }

      applyStyleFilter(style) {
        if (!this.cards || this.cards.length === 0) {
          return;
        }

        const normalized = (style || '').toLowerCase();
        let visibleCount = 0;

        this.cards.forEach((card) => {
          const cardStyle = (card.dataset.style || '').toLowerCase();
          const cardTitleElement = card.querySelector('[data-product-title]');
          const cardTitle = cardTitleElement ? cardTitleElement.textContent.trim() : '(untitled)';
          const shouldShow = normalized === '' || cardStyle === normalized;

          card.style.display = shouldShow ? '' : 'none';
          card.classList.toggle('is-filtered-out', !shouldShow);

          if (shouldShow) {
            visibleCount += 1;
          }
        });

        if (this.emptyState) {
          if (visibleCount === 0) {
            this.emptyState.hidden = false;
          } else {
            this.emptyState.hidden = true;
          }
        }

        if (this.grid) {
          this.grid.dataset.visibleCount = visibleCount;
        }
      }

      logAvailableStyles() {
        if (!this.cards || this.cards.length === 0) {
          return;
        }

        const styleSet = new Set();
        const styleMap = {};

        this.cards.forEach((card) => {
          const rawStyle = (card.dataset.style || '').trim();
          const styleKey = rawStyle !== '' ? rawStyle : '(none)';
          const titleElement = card.querySelector('[data-product-title]');
          const title = titleElement ? titleElement.textContent.trim() : '(untitled)';

          styleSet.add(styleKey);
          if (!styleMap[styleKey]) {
            styleMap[styleKey] = [];
          }
          styleMap[styleKey].push(title);
        });
      }
    }
  

    customElements.define('product-showcase-{{ ai_gen_id }}', ProductShowcase{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product showcase",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#007bff"
    }
  ],
  "presets": [
    {
      "name": "Product showcase"
    }
  ]
}
{% endschema %}