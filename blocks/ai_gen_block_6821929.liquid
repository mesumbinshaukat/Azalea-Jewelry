
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collections-{{ ai_gen_id }} {
    display: flex;
    gap: 40px;
    margin: 120px 22px;
    align-items: stretch;
  }

  .ai-featured-collections__left-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
  }

  .ai-featured-collections__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-featured-collections__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-collections__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-featured-collections__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-featured-collections__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-featured-collections__content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 32px;
    left: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 60%;
    z-index: 2;
  }

  .ai-featured-collections__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}) 0%,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 200.0 }}) 50%,
      transparent 100%
    );
    z-index: 1;
  }

  .ai-featured-collections__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.2;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .ai-featured-collections__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 500;
    transition: background-color 0.3s ease;
    align-self: flex-start;box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .ai-featured-collections__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-featured-collections__right-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-featured-collections__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    height: 100%;
  }

  .ai-featured-collections__collection-card-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.card_background }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-featured-collections__collection-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .ai-featured-collections__card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 260px;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .ai-featured-collections__card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-collections__card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-featured-collections__card-image-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.5;
  }

  .ai-featured-collections__card-content-{{ ai_gen_id }} {
    padding: 16px;
  }

  .ai-featured-collections__card-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.card_text_color }};
    margin: 0;
    text-align: center;
  }

  .ai-featured-collections__card-empty-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 200px;
    background-color: #f9f9f9;
    border: 2px dashed #ddd;
    border-radius: {{ block.settings.card_border_radius }}px;
    color: #999;
    text-align: center;
    padding: 20px;
  }

  .ai-featured-collections__card-empty-{{ ai_gen_id }} svg {
    width: 40px;
    height: 40px;
    margin-bottom: 12px;
    opacity: 0.5;
  }

  @media screen and (max-width: 768px) {
    .ai-featured-collections-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 32px;
      margin: 0 16px;
    }

    .ai-featured-collections__content-{{ ai_gen_id }} {
      bottom: 20px;
      left: 20px;
      max-width: 70%;
    }

    .ai-featured-collections__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .ai-featured-collections__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }
{% endstyle %}<div class="ai-featured-collections-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-collections__left-{{ ai_gen_id }}">
    <div class="ai-featured-collections__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.featured_image %}
        <img
          src="{{ block.settings.featured_image | image_url: width: 800}}"
          alt="{{ block.settings.featured_image.alt | escape }}"
          class="ai-featured-collections__image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.featured_image.width }}"
          height="{{ block.settings.featured_image.height }}"
        ><div class="ai-featured-collections__overlay-{{ ai_gen_id }}"></div>
      {% else %}
        <div class="ai-featured-collections__image-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}<div class="ai-featured-collections__empty-state-{{ ai_gen_id }}">
            Add a featured image
          </div>
        </div>
      {% endif %}

      <div class="ai-featured-collections__content-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-featured-collections__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}

        {% if block.settings.button_text != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" class="ai-featured-collections__button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="ai-featured-collections__right-{{ ai_gen_id }}">
    <div class="ai-featured-collections__grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign custom_image_key = 'custom_image_' | append: i
          assign collection = block.settings[collection_key]
          assign custom_image = block.settings[custom_image_key]
        %}

        {% if collection != blank %}
          <a href="{{ collection.url }}" class="ai-featured-collections__collection-card-{{ ai_gen_id }}">
            <div class="ai-featured-collections__card-image-wrapper-{{ ai_gen_id }}">
              {% if custom_image %}
                <img
                  src="{{ custom_image | image_url: width: 400 }}"
                  alt="{{ custom_image.alt | escape }}"
                  class="ai-featured-collections__card-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="{{ custom_image.width }}"
                  height="{{ custom_image.height }}"
                >
              {% elsif collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 400 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  class="ai-featured-collections__card-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="{{ collection.featured_image.width }}"
                  height="{{ collection.featured_image.height }}"
                >
              {% else %}
                <div class="ai-featured-collections__card-image-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-featured-collections__card-content-{{ ai_gen_id }}">
              <h3 class="ai-featured-collections__card-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
            </div>
          </a>
        {% else %}
          <div class="ai-featured-collections__card-empty-{{ ai_gen_id }}">
            {{ 'collection-apparel-1' | placeholder_svg_tag }}
            <p>Select a collection</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

