{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-product-card-{{ ai_gen_id }} {
    position: relative;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
  }

  .ai-product-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;overflow: hidden;
  }

  .ai-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-label-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    background: {{ block.settings.label_background }};
    color: {{ block.settings.label_text_color }};
    padding: 4px 8px;
    border-radius: {{ block.settings.label_border_radius }}px;
    font-size: 12px;
    font-weight: 500;
    z-index: 2;
  }

  .ai-wishlist-button-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    background: {{ block.settings.wishlist_background }};
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .ai-wishlist-button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.wishlist_hover_background }};
    transform: scale(1.1);
  }

  .ai-wishlist-button-{{ ai_gen_id }} svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: {{ block.settings.wishlist_icon_color }};
    stroke-width: 2;
    transition: fill 0.3s ease, stroke 0.3s ease;
  }

  .ai-wishlist-button-{{ ai_gen_id }}.active svg {
    fill: {{ block.settings.wishlist_active_color }};
    stroke: {{ block.settings.wishlist_active_color }};
  }

  .ai-product-info-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-color-swatches-{{ ai_gen_id }} {
    display: flex;
    gap: 6px;
    margin-bottom:12px;
    flex-wrap: wrap;
  }

  .ai-color-swatch-{{ ai_gen_id }} {
    width: {{ block.settings.swatch_size }}px;
    height: {{ block.settings.swatch_size }}px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: border-color 0.3s ease, transform 0.2s ease;position: relative;
  }

  .ai-color-swatch-{{ ai_gen_id }}:hover {
    transform: scale(1.1);}

  .ai-color-swatch-{{ ai_gen_id }}.active {
    border-color: {{ block.settings.swatch_active_border }};
  }

  .ai-color-swatch-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: calc(100% - 6px);
    height: calc(100% - 6px);
    border-radius: 50%;
    background-color: var(--swatch-color);
  }

  .ai-product-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 500;
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .ai-product-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-title-{{ ai_gen_id }} a:hover {
    text-decoration: underline;
  }

  .ai-product-price-{{ ai_gen_id }} {
    color: {{ block.settings.price_color }};
    font-size: {{ block.settings.price_size }}px;
    font-weight: 600;
    margin: 0;}

  .ai-product-price-compare-{{ ai_gen_id }} {
    color: {{ block.settings.compare_price_color }};
    font-size: {{ block.settings.price_size | minus: 2 }}px;
    text-decoration: line-through;
    margin-left: 8px;
  }

  @media screen and (max-width: 990px) {
    .ai-product-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.grid_gap | divided_by: 2 }}px;
    }

    .ai-product-info-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | divided_by: 1.5 }}px;
    }

    .ai-product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | minus: 2 }}px;
    }

    .ai-product-price-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_size | minus: 2 }}px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-product-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}<product-grid-{{ ai_gen_id }} class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.collection != blank %}
    {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
      <div class="ai-product-card-{{ ai_gen_id }}" data-product-id="{{ product.id }}">
        <div class="ai-product-image-container-{{ ai_gen_id }}">
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 400 }}"
              alt="{{ product.featured_image.alt | escape }}"
              class="ai-product-image-{{ ai_gen_id }}"
              loading="lazy"
              width="400"
              height="400"
              data-main-image
            >
          {% else %}
            <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          {% if block.settings.show_labels and product.metafields.custom.product_label %}
            <div class="ai-product-label-{{ ai_gen_id }}">
              {{ product.metafields.custom.product_label }}
            </div>
          {% endif %}

          {% if block.settings.show_wishlist %}
            <button
              class="ai-wishlist-button-{{ ai_gen_id }}"
              aria-label="Add to wishlist"
              data-product-id="{{ product.id }}"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </button>
          {% endif %}
        </div>

        <div class="ai-product-info-{{ ai_gen_id }}">
          {% if block.settings.show_color_swatches and product.options contains 'Color' %}
            {% assign color_option_index = product.options | map: 'downcase' | where: 'color' | first %}
            {% if color_option_index %}
              {% assign color_option_position = product.options | map: 'downcase' | index: 'color' %}
              <div class="ai-color-swatches-{{ ai_gen_id }}">
                {% assign color_values = product.options[color_option_position].values %}
                {% for color_value in color_values limit: 6 %}
                  {% assign variant_for_color = product.variants | where: 'option1', color_value | first %}
                  {% unless variant_for_color %}
                    {% assign variant_for_color = product.variants | where: 'option2', color_value | first %}
                  {% endunless %}
                  {% unless variant_for_color %}
                    {% assign variant_for_color = product.variants | where: 'option3', color_value | first %}
                  {% endunless %}
                  
                  {% if variant_for_color %}
                    {% assign color_hex = color_value | downcase | replace: ' ', '' %}
                    {% case color_hex %}
                      {% when 'black' %}
                        {% assign swatch_color = '#000000' %}
                      {% when 'white' %}
                        {% assign swatch_color = '#ffffff' %}
                      {% when 'red' %}
                        {% assign swatch_color = '#ff0000' %}
                      {% when 'blue' %}
                        {% assign swatch_color = '#0000ff' %}
                      {% when 'green' %}
                        {% assign swatch_color = '#008000' %}
                      {% when 'yellow' %}
                        {% assign swatch_color = '#ffff00' %}
                      {% when 'pink' %}
                        {% assign swatch_color = '#ffc0cb' %}
                      {% when 'purple' %}
                        {% assign swatch_color = '#800080' %}
                      {% when 'gold' %}
                        {% assign swatch_color = '#ffd700' %}
                      {% when 'silver' %}
                        {% assign swatch_color = '#c0c0c0' %}
                      {% when 'rose' or 'rosegold' %}
                        {% assign swatch_color = '#e8b4a0' %}
                      {% else %}
                        {% assign swatch_color = '#cccccc' %}
                    {% endcase %}

                    <button
                      class="ai-color-swatch-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
                      style="--swatch-color: {{ swatch_color }}"
                      data-variant-id="{{ variant_for_color.id }}"
                      data-variant-image="{% if variant_for_color.image %}{{ variant_for_color.image | image_url: width: 400 }}{% endif %}"
                      aria-label="Select {{ color_value }}"
                    ></button>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          {% endif %}


    


          <h3 class="ai-product-title-{{ ai_gen_id }}">
            <a href="{{ product.url }}">{{ product.title }}</a>
          </h3>

          <div class="ai-product-price-{{ ai_gen_id }}">
            {{ product.price | money }}
            {% if product.compare_at_price > product.price %}
              <span class="ai-product-price-compare-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  {% else %}
    {% for i in (1..8) %}
      <div class="ai-product-card-{{ ai_gen_id }}">
        <div class="ai-product-image-container-{{ ai_gen_id }}"><div class="ai-product-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
          {% if block.settings.show_labels %}
            <div class="ai-product-label-{{ ai_gen_id }}">
              Award Winning
            </div>
          {% endif %}

          {% if block.settings.show_wishlist %}
            <button class="ai-wishlist-button-{{ ai_gen_id }}" aria-label="Add to wishlist">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </button>
          {% endif %}
        </div>

        <div class="ai-product-info-{{ ai_gen_id }}">
          {% if block.settings.show_color_swatches %}<div class="ai-color-swatches-{{ ai_gen_id }}">
              <button class="ai-color-swatch-{{ ai_gen_id }} active" style="--swatch-color: #ffd700" aria-label="Select Gold"></button>
              <button class="ai-color-swatch-{{ ai_gen_id }}" style="--swatch-color: #c0c0c0" aria-label="Select Silver"></button>
              <button class="ai-color-swatch-{{ ai_gen_id }}" style="--swatch-color: #e8b4a0" aria-label="Select Rose Gold"></button>
            </div>
          {% endif %}

          <h3 class="ai-product-title-{{ ai_gen_id }}">
            <a href="#">Sample Product Title</a>
          </h3>

          <div class="ai-product-price-{{ ai_gen_id }}">
            $99.00
          </div>
        </div>
      </div>
    {% endfor %}
  {% endif %}
</product-grid-{{ ai_gen_id }}><script>
(function() {
  class ProductGrid{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.setupColorSwatches();
      this.setupWishlistButtons();
    }

    setupColorSwatches() {
      const swatches = this.querySelectorAll('.ai-color-swatch-{{ ai_gen_id }}');
      
      swatches.forEach(swatch => {
        swatch.addEventListener('click', (e) => {
          e.preventDefault();
          
          const productCard = swatch.closest('.ai-product-card-{{ ai_gen_id }}');
          const cardSwatches = productCard.querySelectorAll('.ai-color-swatch-{{ ai_gen_id }}');
          const mainImage = productCard.querySelector('[data-main-image]');
          const variantImage = swatch.dataset.variantImage;
          
          cardSwatches.forEach(s => s.classList.remove('active'));
          swatch.classList.add('active');
          
          if (variantImage && mainImage) {
            mainImage.style.opacity = '0';
            setTimeout(() => {
              mainImage.src = variantImage;
              mainImage.style.opacity = '1';
            }, 150);
          }
        });
      });
    }

    setupWishlistButtons() {
      const wishlistButtons = this.querySelectorAll('.ai-wishlist-button-{{ ai_gen_id }}');
      
      wishlistButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          e.preventDefault();
          
          const productId = button.dataset.productId;
          const isActive = button.classList.contains('active');
          
          button.classList.toggle('active');
          
          if (productId) {
            const wishlistData = JSON.parse(localStorage.getItem('wishlist') || '[]');
            if (isActive) {
              const index = wishlistData.indexOf(productId);
              if (index > -1) {
                wishlistData.splice(index, 1);
              }
            } else {
              if (!wishlistData.includes(productId)) {
                wishlistData.push(productId);
              }
            }
            
            localStorage.setItem('wishlist', JSON.stringify(wishlistData));
          }
        });
      });
      this.loadWishlistState();
    }

    loadWishlistState() {
      const wishlistData = JSON.parse(localStorage.getItem('wishlist') || '[]');
      const wishlistButtons = this.querySelectorAll('.ai-wishlist-button-{{ ai_gen_id }}');
      
      wishlistButtons.forEach(button => {
        const productId = button.dataset.productId;
        if (productId && wishlistData.includes(productId)) {
          button.classList.add('active');
        }
      });
    }
  }

  customElements.define('product-grid-{{ ai_gen_id }}', ProductGrid{{ ai_gen_id }});
})();
</script>

{% schema %}
{
  "name": "Custom product grid",
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 24,
      "step": 4,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show product labels",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_color_swatches",
      "label": "Show color swatches",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Card colors"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "compare_price_color",
      "label": "Compare price color",
      "default": "#999999"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 16
    },
    {
      "type": "range",
      "id": "price_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Price size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "color",
      "id": "label_text_color",
      "label": "Label text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "label_border_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Label border radius",
      "default": 4
    },
    {
      "type": "header",
      "content": "Wishlist button"
    },
    {
      "type": "color",
      "id": "wishlist_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "wishlist_hover_background",
      "label": "Hover background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "wishlist_icon_color",
      "label": "Icon color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "wishlist_active_color",
      "label": "Active color",
      "default": "#ff0000"
    },
    {
      "type": "header",
      "content": "Color swatches"
    },
    {
      "type": "range",
      "id": "swatch_size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Swatch size",
      "default": 20
    },
    {
      "type": "color",
      "id": "swatch_active_border",
      "label": "Active border color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Custom product grid"
    }
  ],
  "tag": null
}
{% endschema %}