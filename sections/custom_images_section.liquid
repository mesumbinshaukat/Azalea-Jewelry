{% schema %}
{
  "name": "Custom Gallery Section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Our Creations"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View More Creations"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Upload Image"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Custom Gallery",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<section class="custom-gallery">
  <div class="gallery-container">
    <h2 class="gallery-title">{{ section.settings.title }}</h2>

    <div class="gallery-wrapper">
      <div class="gallery-slider">
        {% for block in section.blocks %}
          {% if block.settings.image %}
            <div class="gallery-item">
              <img 
                src="{{ block.settings.image | image_url: width: 600, height: 600 }}" 
                alt="Gallery Image"
                width="600" height="600"
              >
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <!-- arrows visible only on mobile -->
      <button class="gallery-prev">←</button>
      <button class="gallery-next">→</button>
    </div>

    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_link }}" class="gallery-btn">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
</section>

<style>
.custom-gallery {
  margin: 60px auto;
  text-align: center;
  padding: 0 90px;
 
}

.gallery-title {
  font-size: 32px;
  margin-bottom: 40px;
}

.gallery-wrapper {
  position: relative;
  overflow: hidden;
}

.gallery-slider {
  display: flex;
  transition: transform 0.3s ease-in-out;
}

.gallery-item {
  flex: 1 0 25%; /* 4 images per row desktop */
  padding: 0px;
}

.gallery-item img {
width : 280px;
height : 300px;  
 border : 2px solid;
}

/* Arrows - hidden on desktop */
.gallery-prev,
.gallery-next {
  display: none;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border: none;
  font-size: 22px;
  cursor: pointer;
  padding: 8px 12px;
  border-radius: 50%;
  box-shadow: 0 2px 6px rgba(0,0,0,0.2);
  z-index: 5;
}

.gallery-prev { left: 10px; }
.gallery-next { right: 10px; }

/* Button */
.gallery-btn {
  display: inline-block;
  margin-top: 20px;
  padding: 12px 24px;
  background: black;
  color: white;
  text-decoration: none;
  border-radius: 6px;
}

/* Mobile view */
@media (max-width: 768px) {
  .gallery-item {
    flex: 1 0 100%; /* 1 image at a time */
    width : 400px;
  }
  .gallery-prev,
  .gallery-next {
    display: block; /* show arrows only on mobile */
  }
  .gallery-btn {
  display: inline-block;
  margin-top: 20px;
  padding: 12px 24px;
  background: black;
  color: white;
  text-decoration: none;
  border-radius: 6px;
}
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const slider = document.querySelector(".gallery-slider");
  const prevBtn = document.querySelector(".gallery-prev");
  const nextBtn = document.querySelector(".gallery-next");

  if (!slider) return;

  let currentIndex = 0;
  const items = document.querySelectorAll(".gallery-item");
  const totalItems = items.length;

  function updateSlider() {
    const width = items[0].offsetWidth;
    slider.style.transform = `translateX(-${currentIndex * width}px)`;
  }

  nextBtn.addEventListener("click", function() {
    if (currentIndex < totalItems - 1) {
      currentIndex++;
      updateSlider();
    }
  });

  prevBtn.addEventListener("click", function() {
    if (currentIndex > 0) {
      currentIndex--;
      updateSlider();
    }
  });

  window.addEventListener("resize", updateSlider);
});
</script>
